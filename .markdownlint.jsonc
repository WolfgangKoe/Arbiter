{
  // markdownlint-Trial S137–S139 (Stakeholder-Wunsch: Doku als Roh-Markdown lesbar).
  // Gilt für VSCode-Plugin UND markdownlint-cli2 (npm run lint:md).
  "default": true,
  // Zeilenlänge: Projekt-Konvention ~90–100; Code-Blöcke/Tabellen ausgenommen
  "MD013": { "line_length": 100, "code_blocks": false, "tables": false },
  // Gleiche Überschrift in verschiedenen Abschnitten erlaubt (z. B. „Vorgehen")
  "MD024": { "siblings_only": true },
  // Inline-HTML erlaubt (Badges-/Render-Snippets in Specs)
  "MD033": false,
  // Erste Zeile muss KEINE Überschrift sein — Handoff-Dateien starten mit STATUS-Marker
  "MD041": false,
  // Tabellen-Pipe-Stil: Bestandsdoku nutzt kompakte Kopfzeilen — zu laut für den Trial
  "MD060": false,
  // Trailing Spaces: von Stakeholder-Handschrift in Handoffs nicht zu vermeiden
  "MD009": false
}
