{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m coverage *)",
      "Bash(git -C /home/wolfgang/Dokumente/Arbiter *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(pkill -f \"streamlit\")",
      "Bash(streamlit run src/app.py *)",
      "Bash(PYTHONPATH=src streamlit run src/app.py *)",
      "Bash(nohup streamlit run src/app.py *)",
      "Bash(curl -s http://localhost:8501*)",
      "Bash(pip show *)",
      "Bash(.venv/bin/pip *)",
      "Bash(.venv/bin/python tools/wahapedia_scraper.py *)",
      "Bash(mkdir -p data/wahapedia_reference*)",
      "Bash(grep -v \"^$\")",
      "Bash(ruff check *)",
      "Bash(xargs grep -o 'id: [^$]*')",
      "Read(//home/wolfgang/**)",
      "WebFetch(domain:wahapedia.ru)",
      "WebFetch(domain:www.goonhammer.com)",
      "WebSearch",
      "Bash(python3 -c \"from PIL import Image; im=Image.open\\('Fotos/metallisches_wappen_transparenter_hintergrund.png'\\); print\\(im.size, im.mode\\)\")"
    ],
    "additionalDirectories": [
      "/home/wolfgang/Dokumente/Arbiter/.claude/tasks",
      "/tmp"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/wolfgang/Dokumente/Arbiter && .venv/bin/python3 tools/session_context.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Session-Kontext messen"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/wolfgang/Dokumente/Arbiter && grep -q pytest && .venv/bin/python3 tools/token_report.py --write >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Token-Report aktualisieren"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/wolfgang/Dokumente/Arbiter && .venv/bin/python3 tools/freigabe_gate.py",
            "timeout": 10,
            "statusMessage": "Freigabe-Gate prüfen"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/wolfgang/Dokumente/Arbiter && .venv/bin/python3 tools/hook_pytest_foreground.py",
            "timeout": 10,
            "statusMessage": "pytest-Foreground-Gate prüfen"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/wolfgang/Dokumente/Arbiter && .venv/bin/python3 tools/test_report_reminder.py 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Token-Report-Reminder"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f /home/wolfgang/Dokumente/Arbiter/.claude/.freigabe",
            "timeout": 5,
            "statusMessage": "Freigabe-Gate scharf schalten"
          }
        ]
      }
    ]
  }
}
